{
  "permissions": {
    "allow": [
      "PowerShell($env:PYTHONPATH*)",
      "PowerShell(Start-Sleep*)",
      "PowerShell(cd D:\\rhyme*)",
      "Bash(PYTHONPATH=*)"
    ],
    "deny": [
      "Bash(rm*)",
      "Bash(git push*)",
      "Bash(git reset*)",
      "Bash(git rebase*)",
      "Bash(git commit --amend*)",
      "PowerShell(*Remove-Item*)",
      "PowerShell(*Clear-Content*)",
      "PowerShell(*Stop-Process*)",
      "PowerShell(*Start-Job*)",
      "PowerShell(*Diagnostics.Process*)",
      "PowerShell(*schtasks /run*)",
      "PowerShell(*schtasks /delete*)",
      "PowerShell(*schtasks /change*)",
      "Bash(*schtasks /run*)",
      "Bash(*schtasks /delete*)",
      "Bash(*schtasks /change*)"
    ]
  }
}
