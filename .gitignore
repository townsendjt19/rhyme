# Credentials — never commit
.env

# Python
__pycache__/
*.py[cod]
*.pyo

# Virtual environment — scoped to D:\rhyme to fix a base-interpreter bug
# where sys.prefix resolves to the bare "D:" (no trailing slash), making
# site-packages a cwd-dependent drive-relative path. Recreate with:
#   D:\python.exe -m venv D:\rhyme\venv
#   D:\rhyme\venv\Scripts\python.exe -m pip install -r requirements.txt
venv/

# Backtest CSV outputs — regenerable
backtest_*.csv
backtests/
# Allow verified results committed intentionally under results/
!results/backtest_*.csv
losses_enriched.csv

# Paper trade runtime files
paper_trades.csv
paper_trader.log
paper_trader.err
paper_trader.pid
paper_trader_*.pid
paper_trade_*_stdout.log
paper_trade_*_stderr.log
paper_trade_stdout.log
paper_trade_stderr.log
# Retired modes' logs are archived here (GOVERNANCE retirement convention #2)
logs/

# OS / editor
.DS_Store
Thumbs.db
*.swp
*.swo

# Personal live-account experiment -- logs/state local only (code is committed)
personal_live/*.log
personal_live/*.pid

# spread2b runtime state (idea/suspension flags) -- broker is source of truth
spread_state_2b.json

# Dashboard heartbeat runtime artifacts (bot-written, regenerated every wake)
ftmo_trial/state.json
ftmo_trial/state.json.tmp
ftmo_trial/state_history.ndjson
